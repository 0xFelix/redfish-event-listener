apiVersion: apps/v1
kind: Deployment
metadata:
  name: redfish-event-listener
  namespace: REPLACE_WITH_FAR_NAMESPACE
  labels:
    app: redfish-event-listener
spec:
  replicas: 2
  selector:
    matchLabels:
      app: redfish-event-listener
  template:
    metadata:
      labels:
        app: redfish-event-listener
    spec:
      serviceAccountName: redfish-event-listener
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app: redfish-event-listener
            topologyKey: kubernetes.io/hostname
      containers:
      - name: redfish-event-listener
        image: REPLACE_WITH_YOUR_IMAGE
        imagePullPolicy: Always
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        env:
        - name: REDFISH_INSECURE
          valueFrom:
            secretKeyRef:
              name: redfish-credentials
              key: insecure
        - name: DESTINATION_URL
          valueFrom:
            secretKeyRef:
              name: redfish-credentials
              key: destinationURL
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: DEPLOYMENT_NAME
          value: redfish-event-listener
        - name: DELETE_SUBS_ON_EXIT
          value: "false"
